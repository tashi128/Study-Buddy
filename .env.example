# OpenAI / model provider
DEEPSEEK_API_KEY=your_api_key_here

# Public URL for your deployed app.
# Example for Streamlit Community Cloud:
# APP_BASE_URL=https://your-app-name.streamlit.app
APP_BASE_URL=https://your-public-app-url

# ===== GOOGLE OAUTH =====
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret

# Optional: leave blank to let the app derive the callback from APP_BASE_URL.
# For local development, you can set this to http://localhost:8501
GOOGLE_REDIRECT_URI=

# ===== APPLE OAUTH =====
APPLE_TEAM_ID=your_team_id
APPLE_CLIENT_ID=your_service_id
APPLE_KEY_ID=your_key_id
APPLE_PRIVATE_KEY="-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"

# Optional: leave blank to configure this separately if needed.
APPLE_REDIRECT_URI=
